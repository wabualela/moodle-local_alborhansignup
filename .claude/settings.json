{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git describe *)",
      "Bash(git ls-files *)",
      "Bash(git tag --list *)",
      "Bash(git remote get-url *)",
      "Bash(php -l *)",
      "Bash(php8.3 -l *)",
      "Bash(php8.4 -l *)",
      "Bash(bash -n *)",
      "Bash(node --check *)",
      "Bash(./dev/check.sh *)",
      "Bash(dev/check.sh *)",
      "Bash(./dev/ci-status.sh *)",
      "Bash(dev/ci-status.sh *)",
      "Bash(./dev/build.sh *)",
      "Bash(dev/build.sh *)",
      "Bash(node dev/jsdom/run.js *)",
      "Bash(curl -s https://api.github.com/repos/wabualela/moodle-local_alborhansignup/*)",
      "Bash(curl -sS https://api.github.com/repos/wabualela/moodle-local_alborhansignup/*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:moodledev.io)",
      "WebFetch(domain:docs.moodle.org)"
    ],
    "ask": [
      "Bash(./dev/check.sh --install*)",
      "Bash(dev/check.sh --install*)",
      "Bash(./dev/check.sh * --install*)",
      "Bash(dev/check.sh * --install*)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(rsync *)",
      "Bash(rm -rf *)",
      "Bash(docker *)",
      "Bash(php*admin/cli/*)",
      "Bash(*vendor/bin/phpunit*)",
      "Bash(*vendor/bin/behat*)",
      "Bash(curl *-X POST*)",
      "Bash(curl *-XPOST*)",
      "Bash(curl *-d *)",
      "Bash(curl *--data*)",
      "Bash(curl *-F *)",
      "Bash(curl *--form*)",
      "Bash(wget *--post*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(rsync *public/local/*)",
      "Bash(php*admin/cli/upgrade.php*)",
      "Bash(php*admin/cli/maintenance.php*)",
      "Bash(php*admin/cli/install*)",
      "Bash(php*admin/cli/uninstall_plugins.php*)",
      "Bash(php*admin/cli/cfg.php*)",
      "Bash(php*admin/cli/reset_password.php*)",
      "Bash(php*admin/tool/phpunit/cli/init.php*)",
      "Bash(php*admin/tool/phpunit/cli/util.php*)",
      "Bash(php*admin/tool/behat/cli/init.php*)",
      "Bash(php*admin/tool/behat/cli/util.php*)",
      "Bash(mysql *)",
      "Bash(mariadb *)",
      "Bash(mysqldump *)",
      "Bash(psql *)",
      "Bash(pg_dump *)"
    ]
  }
}
